# Blockchain RPC Endpoints (Optional for online features; leave blank or use public RPCs)
ETH_RPC_URL=https://eth-mainnet.public.blastapi.io
BSC_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Blockchain Explorer API Keys (Optional; required for verified source retrieval by address)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY_HERE
BSCSCAN_API_KEY=YOUR_BSCSCAN_API_KEY_HERE
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY_HERE
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY_HERE

# Optional External Simulation Service APIs
HONEYPOT_IS_API_URL=https://api.honeypot.is/v2/IsHoneypot
GOPLUS_API_URL=https://api.gopluslabs.io/api/v1/token_security

# Application Configuration
DEFAULT_NETWORK=ethereum
REQUEST_TIMEOUT_SECONDS=15
MAX_SOURCE_CODE_SIZE_KB=1024

# Risk Scoring Thresholds (0-100 scale)
RISK_THRESHOLD_MODERATE=25
RISK_THRESHOLD_HIGH=50
RISK_THRESHOLD_CRITICAL=75

# MERN Backend & MongoDB Configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/honeypot_detector

